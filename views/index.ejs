<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <title>Dashboard - Olimpíadas de Matemática</title>

  <style>
    body {
      background-color: #f8f9fa;
    }

    .card-summary {
      border-radius: 12px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
      text-align: center;
      padding: 20px;
      transition: transform 0.2s;
    }

    .card-summary:hover {
      transform: translateY(-4px);
    }

    h2, h4 {
      color: #2c3e50;
    }
  </style>
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/">🏆 Olimpíadas de Matemática</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link active" href="/">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="/escolas">Escolas</a></li>
          <li class="nav-item"><a class="nav-link" href="/alunos">Alunos</a></li>
          <li class="nav-item"><a class="nav-link" href="/sobre">Sobre</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Conteúdo -->
  <div class="container my-5">

    <!-- Resumo -->
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="card card-summary">
          <h4>Total de Escolas</h4>
          <h2> <%= totalEscolas %></h2>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card card-summary">
          <h4>Total de Alunos</h4>
          <h2> <%= totalAlunos[0].total %></h2>
          
          
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card card-summary">
          <h4>Cartões Processados</h4>
          <h2>0</h2>
        </div>
      </div>
    </div>

    <!-- Gráficos -->
    <div class="row">
      

      <div class="col-md-6 mb-4">
        <div class="card p-3">
          <h5 class="text-center">Distribuição por Nível da Prova</h5>
          <div class="card card-summary">
          <h4>Alfa: <%= qtdPorNivel[0]%> </h4>
          </div>
          <br>
          <div class="card card-summary">
          <h4>Beta:<%= qtdPorNivel[1]%></h4>
          </div>
        </div>
      </div>
      <div class="col-md-6 mb-4">
        <div class="card p-3">
          <h5 class="text-center">Alunos por Escola</h5>
          <table class="table table-striped align-middle">
           <thead>
          <tr>
           
            <th>Nome</th>
            <th>Quantidade</th>
          </tr>
        </thead>
           <tbody>
            
          <%  for(i = 0; i < nomesEscolas.length;i++){  %>
            <tr>
              <td><%= nomesEscolas[i]%></td> 
              <td><%= qtdAlunos[i]%></td> 
            </tr>
          <% } %>
        </tbody>
        </table>
        </div>
      </div>
    </div>

  </div>

  <!-- Footer -->
  <!-- <footer class="text-center py-3 bg-dark text-light">
    <small>© 2025 - Olimpíadas de Matemática de Caxias-MA | Dashboard</small>
  </footer> -->

  <script>
    // Exemplo de dados vindos do backend
   


  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
