<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <title>Escolas - Olimpíadas de Matemática</title>

  <style>
    body {
      background-color: #f8f9fa;
    }

    .navbar-brand {
      font-weight: bold;
      font-size: 1.2rem;
    }

    h2 {
      color: #2c3e50;
    }

    .card {
      border-radius: 12px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    table {
      border-radius: 10px;
      overflow: hidden;
    }
  </style>
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/">🏆 Olimpíadas de Matemática - Caxias-MA</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link active" href="/escolas">Escolas</a></li>
          <li class="nav-item"><a class="nav-link" href="/alunos">Alunos</a></li>
          <li class="nav-item"><a class="nav-link active" href="/sobre">Sobre</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Conteúdo -->
  <div class="container my-5">
    <div class="card p-4">
      <h2 class="mb-4">📚 Lista de Escolas de Caxias - MA</h2>

      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>Escola</th>
              <th>Área</th>
              <th>Ver</th>
            </tr>
          </thead>
          <tbody>
            <% escolas.forEach(escola=> { %>
              <tr>
                <td><%= escola.nome %></td>
                <td><%= escola.area %></td>
                <td><a href="/escolas/<%= escola.id_escola %>" class="btn btn-sm btn-outline-primary">🔎 Ver</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Bootstrap Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

  <%- include('partials/footer') %>
</body>
</html>
